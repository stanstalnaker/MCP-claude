# Public HTTPS origin of this server. Users add <PUBLIC_URL>/mcp as a custom connector in Claude.
PUBLIC_URL=https://mcp.hubculture.com
PORT=8080

# HubID. HUBID_CLIENT_ID is the id of an ApiApps record for this connector (title shown on HubID's
# consent screen, e.g. "Claude"). The keys are that app's Public-Key / Private-Key.
HUBID_URL=https://id.hubculture.com
HUBID_CLIENT_ID=
HUBID_PUBLIC_KEY=
HUBID_PRIVATE_KEY=

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the HubID tokens held for signed-in users.
TOKEN_ENCRYPTION_KEY=

# Redis keeps sign-ins across restarts and instances. Without it they live in memory.
REDIS_URL=redis://localhost:6379

# Public Ven rates API (hub/Ven.vc-Core-Laravel).
VEN_RATES_URL=https://apilaravel.ven.vc

# Optional: Ven purchase tools. The interchange's HUB_SHARED_SECRET (Hub's PAYMENTS_INTERCHANGE_SECRET).
PAYMENTS_URL=
PAYMENTS_SHARED_SECRET=

# Optional: ask_zeke. ZEKE_SYSTEM_TOKEN is zeke-ai-server's system bearer token.
ZEKE_URL=
ZEKE_SYSTEM_TOKEN=

# Connector Ven mandate: enforced for members, and a ceiling over each agent's own HubID mandate.
VEN_SEND_PER_TX=100
VEN_SEND_PER_DAY=500

# Scopes granted when a client asks for none (claude.ai asks for none). Space or comma separated.
# All: profile:read hubid:write hubs:read hubs:write messages:read messages:send ven:read ven:request ven:send ven:purchase zeke:ask
DEFAULT_SCOPES=profile:read hubid:write hubs:read hubs:write messages:read messages:send ven:read ven:request ven:send ven:purchase zeke:ask

# Kill switch: tools to turn off for everyone, e.g. DISABLED_TOOLS=ven_send,ven_create_purchase_order
DISABLED_TOOLS=

# Per sign-in rate limits.
RATE_LIMIT_READ_PER_MINUTE=60
RATE_LIMIT_WRITE_PER_MINUTE=10

# How long an agent persona stays connected before its owner reconnects it (the agent key itself can be revoked any time).
AGENT_GRANT_DAYS=90

# Redirect URIs that dynamically registered clients may use. "host:*" allows any port.
# Default: Claude's callbacks plus http://localhost:* and http://127.0.0.1:* for local clients.
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback https://claude.com/api/mcp/auth_callback http://localhost:* http://127.0.0.1:*
